<?xml version="1.0" encoding="utf-8"?>
<!-- Produção: só HTTPS e só as autoridades do sistema (sem certificados instalados pelo usuário). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
